<?xml version="1.0" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.version.id.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="version_number" groups="base.group_system" />
                <field name="id_number_info" groups="base.group_system" />
            </field>
        </field>
    </record>
</odoo>
