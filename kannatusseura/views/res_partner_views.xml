<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Kannatusseura page extending contacts form view-->
    <record id="res_partner_kannatusseura" model="ir.ui.view">
        <field name="name">res.partner.kannatusseura</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='email']]" position="after">
                <field name="user_kannatusseura" />
            </xpath>
        </field>
    </record>

    <!-- Kannatusseura filter-->
    <record id="filter_kannatusseura_name_not_null" model="ir.filters">
        <field name="name">Kannatusseurallinen</field>
        <field name="model_id">res.partner</field>
        <field name="domain">[('user_kannatusseura', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="is_default" eval="False" />
        <field name="user_id" eval="False" />
    </record>
</odoo>
