<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_kannatusseura_form_action" inherit_id="portal.portal_my_details">
        <xpath expr="//form" position="attributes">
            <attribute name="action">/my/account/save</attribute>
        </xpath>
    </template>
    <template
        id="portal_my_kannatusseura_fields"
        inherit_id="portal.portal_my_details_fields"
    >
        <xpath expr="//input[@name='email']//.." position="before">
            <div
                name="name-extension-input"
                t-attf-class="form-group #{error.get('kannatusseura') and 'o_has_error' or ''} col-xl-6"
            >
                <label class="col-form-label" for="kannatusseura">Kannatusseura</label>
                
                <select name="user_kannatusseura" class="form-control">
                    <t t-if="not partner.user_kannatusseura">
                        <option value="">Select...</option>
                    </t>
                    <t t-foreach="kannatusseurat" t-as="k">
                        <option t-att-value="k.id"
                                t-att-selected="partner.user_kannatusseura.id == k.id and 'selected' or None">
                            <t t-esc="k.display_name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </template>
</odoo>
