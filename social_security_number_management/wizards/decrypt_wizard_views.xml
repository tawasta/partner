<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_ssn_decrypt_wizard_form" model="ir.ui.view">
        <field name="name">partner.ssn.decrypt.wizard.form</field>
        <field name="model">partner.ssn.decrypt.wizard</field>
        <field name="arch" type="xml">
            <form string="Decrypt Personal ID">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="key"/>
                </group>
                <div>
                    <p class="text-muted">
                        Showing Personal Identification Numbers requires a decryption key.
                        You can request it from your system administrator. The decrypted
                        number is only shown in a temporary notification and is never
                        stored in the database in plain text.
                    </p>
                </div>
                <footer>
                    <button
                        string="Decrypt"
                        type="object"
                        name="decrypt_social_security_number"
                        class="btn-primary"
                    />
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_ssn_decrypt_wizard" model="ir.actions.act_window">
        <field name="name">Decrypt Personal ID</field>
        <field name="res_model">partner.ssn.decrypt.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_ssn_decrypt_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
