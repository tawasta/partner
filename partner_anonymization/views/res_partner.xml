<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.tree.anonymization</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">date_to_be_anonymized</attribute>
            </xpath>

            <field name="active" position="after">
                <field name="date_to_be_anonymized" optional="hide" />
                <field name="date_anonymized" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">res.partner.search.anonymization</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">

            <filter name="inactive" position="after">
                    <separator />
                    <filter
                    string="To be anonymized"
                    name="to_anonymize"
                    domain="[('date_to_be_anonymized', '!=', False)]"
                />
            </filter>
        </field>
    </record>

</odoo>
