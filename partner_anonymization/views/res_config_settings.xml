<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.anonymization</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <div id="contacts_settings" position="after">
                <div id="contacts_anonymization">
                    <block
                        title="Contact anonymization"
                        name="contacts_anonymization_container"
                    >
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="partner_anonymization" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="partner_anonymization" />
                                <div class="text-muted">
                                    Automatically anonymize contacts.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label
                                    for="partner_anonymization_modification_delay"
                                    invisible="not partner_anonymization"
                                />
                                <field
                                    name="partner_anonymization_modification_delay"
                                    invisible="not partner_anonymization"
                                />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label
                                    for="partner_anonymization_remove_delay"
                                    invisible="not partner_anonymization"
                                />
                                <field
                                    name="partner_anonymization_remove_delay"
                                    invisible="not partner_anonymization"
                                />
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <field
                                name="partner_anonymization_domain"
                                widget="domain"
                                options='{"model": "res.partner"}'
                                invisible="not partner_anonymization"
                            />
                        </div>
                    </block>
                </div>
            </div>

        </field>
    </record>

</odoo>
