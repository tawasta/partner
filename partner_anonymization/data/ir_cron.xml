<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_schedule_anonymize_partners" model="ir.cron">
        <field name="name">Contacts: Schedule anonymization</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="state">code</field>
        <field name="code">model._cron_schedule_anonymize_partners()</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="ir_cron_anonymize_partners" model="ir.cron">
        <field name="name">Contacts: Anonymize</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="state">code</field>
        <field name="code">model._cron_anonymize_partners()</field>
        <field name="active" eval="False" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
