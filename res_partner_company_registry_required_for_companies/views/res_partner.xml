<?xml version="1.0" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field
            name="name"
        >res.partner.form.inherit.required.company.registry.for.cmopanies</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <!-- the field is not shown if there is a parent, so do not make it mandatory in those
            cases either -->
            <field name="company_registry" position="attributes">
                <attribute name="required">is_company and not parent_id </attribute>
            </field>

        </field>
    </record>
</odoo>
