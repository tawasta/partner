<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="partner_map_view_res_company_view" model="ir.ui.view">
        <field name="name">partner.map.view.res.company.view</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page string="Location" name="location">
                    <span>
                        Lat:
                        <field name="company_latitude" />
                    </span>
                    <span>
                        Long:
                        <field name="company_longitude" />
                    </span>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
