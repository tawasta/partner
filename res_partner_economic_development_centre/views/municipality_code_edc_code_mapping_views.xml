<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_municipalicy_code_edc_code_mapping_tree" model="ir.ui.view">
        <field name="name">res.municipalicy_code_edc_code_mapping.view.tree</field>
        <field name="model">res.municipalicy_code_edc_code_mapping</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="municipality_code" />
                <field name="economic_development_centre_code" />
            </tree>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="act_open_municipalicy_code_edc_code_mapping_view"
    >
        <field
            name="name"
        >Municipality Code to Economic Development Centre Code Mappings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.municipalicy_code_edc_code_mapping</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_municipalicy_code_edc_code_mapping_sub"
        name="Municipality Code to Economic Development Centre Code Mappings"
        parent="contacts.menu_localisation"
        sequence="70"
        action="act_open_municipalicy_code_edc_code_mapping_view"
    />
</odoo>
