<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_partner_date_range_type_tree" model="ir.ui.view">
        <field name="name">res.partner.date.range.type.tree</field>
        <field name="model">res.partner.date.range.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_res_partner_date_range_type_form" model="ir.ui.view">
        <field name="name">res.partner.date.range.type.form</field>
        <field name="model">res.partner.date.range.type</field>
        <field name="arch" type="xml">
            <form string="Partner Date Range Type">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" readonly="0" />
                    </group>
                    <group>
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
