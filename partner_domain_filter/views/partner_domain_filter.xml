<odoo>
  <record id="view_partner_domain_filter_tree" model="ir.ui.view">
    <field name="name">partner.domain.filter.tree</field>
    <field name="model">partner.domain.filter</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="filter_domain" optional="show" />
      </list>
    </field>
  </record>

  <record id="view_partner_domain_filter_form" model="ir.ui.view">
    <field name="name">partner.domain.filter.form</field>
    <field name="model">partner.domain.filter</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <widget
            name="web_ribbon"
            title="Archived"
            bg_color="text-bg-danger"
            invisible="active"
          />
          <group>
            <field name="active" invisible="1" />
            <field name="name" />
            <field name="color" widget="color_picker" />
            <field name="description" />
            <field
              name="filter_domain"
              widget="domain"
              options='{"model": "res.partner"}'
            />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_partner_domain_filter" model="ir.actions.act_window">
    <field name="name">Partner Domain Filters</field>
    <field name="res_model">partner.domain.filter</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="menu_partner_domain_filter"
    name="Partner Filters"
    sequence="2"
    parent="contacts.res_partner_menu_config"
    action="action_partner_domain_filter"
  />
</odoo>
