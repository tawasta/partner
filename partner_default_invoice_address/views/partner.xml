<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_default_invoice" model="ir.ui.view">
        <field name="name">res.partner.form.default.partner.invoice</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="child_ids" position="before">
                <group>
                    <group>
                        <field name="default_partner_invoice_id"/>
                    </group>
                </group>
            </field>
        </field>
    </record>

    <record id="view_partner_tree_inherit_default_invoice" model="ir.ui.view">
        <field name="name">res.partner.list.default.partner.invoice</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="default_partner_invoice_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
