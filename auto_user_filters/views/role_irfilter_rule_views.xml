<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_role_irfilter_rule" model="ir.actions.act_window">
        <field name="name">Role Auto Filters</field>
        <field name="res_model">role.irfilter.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_role_auto_irfilters_root"
              name="Role Auto Filters"
              parent="base.menu_administration"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_role_irfilter_rule"
              name="Rules"
              parent="menu_role_auto_irfilters_root"
              action="action_role_irfilter_rule"
              sequence="10"
              groups="base.group_system"/>

    <record id="view_role_irfilter_rule_tree" model="ir.ui.view">
        <field name="name">role.irfilter.rule.tree</field>
        <field name="model">role.irfilter.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="role_id"/>
                <field name="model_id"/>
                <field name="filter_name"/>
                <field name="is_default"/>
                <field name="action_id"/>
                <field name="only_leaf_companies"/>
            </tree>
        </field>
    </record>

    <record id="view_role_irfilter_rule_form" model="ir.ui.view">
        <field name="name">role.irfilter.rule.form</field>
        <field name="model">role.irfilter.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="role_id"/>
                    </group>

                    <group string="Filter">
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="filter_name"/>
                        <field name="is_default"/>
                        <field name="action_id"/>
                        <field name="only_leaf_companies"/>
                    </group>

                    <group string="Domain Template">
                        <field name="domain_template"/>
                    </group>

                    <group string="Help">
                        <div class="o_form_label">
                            Use variable: <code>user_company_ids</code> (list of company IDs).
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
