<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_partner_form_aliases" model="ir.ui.view">
    <field name="name">res.partner.form.aliases</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Aliases" name="contact_aliases">
          <field name="alias_ids" context="{'default_partner_id': id}">
            <list editable="bottom">
              <field name="name" />
              <field name="active" />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
